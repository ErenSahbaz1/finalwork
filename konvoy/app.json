{
	"expo": {
		"name": "Convoi",
		"slug": "convoi",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.svg",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"scheme": "convoi",
		"splash": {
			"image": "./assets/splash-icon.svg",
			"resizeMode": "contain",
			"backgroundColor": "#ffffff"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.konvoy.app",
			"infoPlist": {
				"NSLocationWhenInUseUsageDescription": "Convoi uses your location to show your vehicle on the convoy map."
			}
		},
		"android": {
			"package": "com.konvoy.app",
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			"expo-router",
			"@react-native-community/datetimepicker",
			"expo-web-browser"
		]
	}
}
